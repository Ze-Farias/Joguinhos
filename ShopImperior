<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Império de Lojas 🏪</title>
<link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:#0d1117; --surface:#161b22; --panel:#21262d; --border:#30363d;
    --text:#e6edf3; --muted:#7d8590; --gold:#ffd700;
    --toy-accent:#ff6eb4; --toy-accent2:#ff3d9a;
    --ph-accent:#3dd68c;  --ph-accent2:#2aab6f;
    --fd-accent:#ff9900;  --fd-accent2:#e07000;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{font-family:'Quicksand',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;overflow-x:hidden;}

  /* ── SIDEBAR ── */
  .sidebar-nav{width:220px;flex-shrink:0;background:var(--surface);border-right:2px solid var(--border);display:flex;flex-direction:column;position:fixed;left:0;top:0;bottom:0;z-index:100;overflow-y:auto;}
  .sidebar-logo{padding:18px 16px 10px;font-family:'Lilita One',cursive;font-size:1.05rem;color:var(--gold);border-bottom:1px solid var(--border);text-align:center;line-height:1.3;}
  .sidebar-logo span{display:block;font-size:.68rem;color:var(--muted);font-family:'Quicksand',sans-serif;font-weight:600;margin-top:2px;}
  .money-box{margin:10px;background:var(--panel);border:2px solid var(--gold);border-radius:12px;padding:9px;text-align:center;}
  .money-box .lbl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;}
  .money-box .amt{font-family:'Lilita One',cursive;font-size:1.35rem;color:var(--gold);}
  .sb-sec{padding:7px 12px 3px;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1.5px;font-weight:700;}
  .nav-btn{margin:3px 8px;padding:9px 12px;border-radius:10px;border:2px solid transparent;background:transparent;color:var(--muted);font-family:'Quicksand',sans-serif;font-size:13px;font-weight:700;cursor:pointer;text-align:left;display:flex;align-items:center;gap:9px;transition:all .15s;width:calc(100% - 16px);}
  .nav-btn:hover{background:var(--panel);color:var(--text);}
  .nav-btn.active-toy{background:rgba(255,110,180,.15);border-color:var(--toy-accent);color:var(--toy-accent);}
  .nav-btn.active-ph {background:rgba(61,214,140,.15);border-color:var(--ph-accent);color:var(--ph-accent);}
  .nav-btn.active-fd {background:rgba(255,153,0,.15);border-color:var(--fd-accent);color:var(--fd-accent);}
  .nav-icon{font-size:17px;}
  .nav-badge{margin-left:auto;font-size:10px;padding:2px 6px;border-radius:10px;background:var(--panel);}

  /* Employee panel */
  .emp-panel{margin:6px 8px;background:var(--panel);border:2px solid var(--border);border-radius:12px;padding:10px;}
  .emp-title{font-family:'Lilita One',cursive;font-size:.82rem;color:var(--text);margin-bottom:7px;display:flex;align-items:center;gap:5px;}
  .emp-card{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:7px;margin-bottom:5px;font-size:11px;}
  .emp-name{font-weight:700;display:flex;align-items:center;gap:5px;margin-bottom:3px;}
  .emp-status{color:var(--muted);font-size:10px;}
  .emp-status.working{color:var(--fd-accent);}
  .emp-assign-btns{display:flex;gap:3px;margin-top:5px;}
  .emp-assign-btn{flex:1;padding:3px 0;border-radius:5px;border:1px solid var(--border);background:var(--panel);color:var(--muted);font-family:'Quicksand',sans-serif;font-size:9px;font-weight:700;cursor:pointer;transition:all .15s;}
  .emp-assign-btn:hover{border-color:var(--gold);color:var(--gold);}
  .emp-assign-btn.asgn-toy{border-color:var(--toy-accent);color:var(--toy-accent);background:rgba(255,110,180,.1);}
  .emp-assign-btn.asgn-ph {border-color:var(--ph-accent);color:var(--ph-accent);background:rgba(61,214,140,.1);}
  .emp-assign-btn.asgn-fd {border-color:var(--fd-accent);color:var(--fd-accent);background:rgba(255,153,0,.1);}
  .hire-btn{width:100%;padding:7px;border-radius:8px;border:2px dashed var(--border);background:transparent;color:var(--muted);font-family:'Quicksand',sans-serif;font-size:11px;font-weight:700;cursor:pointer;transition:all .15s;margin-top:3px;}
  .hire-btn:hover:not(:disabled){border-color:var(--gold);color:var(--gold);}
  .hire-btn:disabled{opacity:.4;cursor:not-allowed;}
  .sb-stats{margin:5px 8px 14px;display:flex;flex-direction:column;gap:3px;}
  .sstat{background:var(--panel);border-radius:7px;padding:5px 9px;display:flex;justify-content:space-between;align-items:center;font-size:10px;}
  .sstat .sv{font-weight:700;color:var(--gold);}

  /* ── MAIN ── */
  .main-area{margin-left:220px;flex:1;display:flex;flex-direction:column;min-height:100vh;}
  .store-header{padding:12px 18px;border-bottom:2px solid var(--border);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:40;transition:background .3s;}
  .store-header.toy-hdr{background:#1a0d14;border-color:rgba(255,110,180,.3);}
  .store-header.ph-hdr {background:#0d1a12;border-color:rgba(61,214,140,.3);}
  .store-header.fd-hdr {background:#1a0e00;border-color:rgba(255,153,0,.3);}
  .store-name{font-family:'Lilita One',cursive;font-size:1.4rem;}
  .toy-hdr .store-name{color:var(--toy-accent);text-shadow:0 0 20px rgba(255,110,180,.4);}
  .ph-hdr  .store-name{color:var(--ph-accent); text-shadow:0 0 20px rgba(61,214,140,.4);}
  .fd-hdr  .store-name{color:var(--fd-accent); text-shadow:0 0 20px rgba(255,153,0,.4);}
  .store-meta{display:flex;align-items:center;gap:10px;font-size:12px;}
  .store-lvl{padding:3px 11px;border-radius:20px;font-weight:700;font-size:12px;}
  .toy-hdr .store-lvl{background:rgba(255,110,180,.2);color:var(--toy-accent);}
  .ph-hdr  .store-lvl{background:rgba(61,214,140,.2);color:var(--ph-accent);}
  .fd-hdr  .store-lvl{background:rgba(255,153,0,.2);color:var(--fd-accent);}
  .xp-wrap{min-width:140px;}
  .xp-lbl{font-size:10px;color:var(--muted);margin-bottom:2px;display:flex;justify-content:space-between;}
  .xp-bg{height:6px;background:var(--border);border-radius:3px;overflow:hidden;}
  .xp-fill{height:100%;border-radius:3px;transition:width .5s;width:0%;}
  .toy-xp{background:linear-gradient(90deg,var(--toy-accent),#ffaadd);}
  .ph-xp {background:linear-gradient(90deg,var(--ph-accent),#aaffcc);}
  .fd-xp {background:linear-gradient(90deg,var(--fd-accent),#ffdd88);}

  /* Store views */
  .store-view{display:none;flex:1;padding:14px;}
  .store-view.active{display:flex;gap:12px;}
  .store-main{flex:1;display:flex;flex-direction:column;gap:12px;}

  /* Boxes */
  .orders-box,.products-box{border:2px solid var(--border);border-radius:14px;padding:13px;}
  .toy-box{background:#1a0d14;border-color:rgba(255,110,180,.3);}
  .ph-box {background:#0d1a12;border-color:rgba(61,214,140,.3);}
  .fd-box {background:#1a0e00;border-color:rgba(255,153,0,.3);}
  .products-box{flex:1;}
  .box-title{font-family:'Lilita One',cursive;font-size:.92rem;margin-bottom:9px;display:flex;align-items:center;gap:7px;}
  .toy-box .box-title{color:var(--toy-accent);}
  .ph-box  .box-title{color:var(--ph-accent);}
  .fd-box  .box-title{color:var(--fd-accent);}

  /* Orders list */
  .orders-list{display:flex;gap:7px;flex-wrap:wrap;min-height:95px;padding:7px;border-radius:10px;background:rgba(0,0,0,.3);border:2px dashed var(--border);align-content:flex-start;}
  .order-card{background:var(--surface);border:2px solid var(--border);border-radius:10px;padding:7px 9px;display:flex;flex-direction:column;align-items:center;gap:2px;min-width:74px;position:relative;overflow:hidden;animation:popCard .4s cubic-bezier(.175,.885,.32,1.275);transition:border-color .3s,box-shadow .3s;}
  .order-card.urg-toy{border-color:var(--toy-accent);box-shadow:0 0 12px rgba(255,110,180,.5);}
  .order-card.urg-ph {border-color:var(--ph-accent); box-shadow:0 0 12px rgba(61,214,140,.5);}
  .order-card.urg-fd {border-color:var(--fd-accent);  box-shadow:0 0 12px rgba(255,153,0,.5);}
  .order-card.done-anim{animation:doneFlash .55s ease forwards;}
  @keyframes doneFlash{0%{opacity:1;transform:scale(1);}40%{opacity:1;transform:scale(1.12);background:rgba(255,215,0,.2);}100%{opacity:0;transform:scale(.7);}}
  .oc-cust{font-size:17px;line-height:1;}
  .oc-emoji{font-size:21px;line-height:1;}
  .oc-name{font-size:9px;font-weight:700;text-align:center;}
  .oc-price{font-size:10px;color:var(--gold);font-weight:700;}
  .oc-time{font-size:9px;color:var(--muted);}
  .oc-bar{position:absolute;bottom:0;left:0;right:0;height:4px;background:var(--border);}
  .oc-fill{height:100%;transition:width 1s linear,background-color .3s;}
  .no-orders{color:var(--muted);font-size:11px;text-align:center;width:100%;padding:18px;font-style:italic;}

  /* Level tabs */
  .level-tabs{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:9px;}
  .ltab{padding:3px 8px;border-radius:20px;border:1px solid var(--border);background:transparent;color:var(--muted);font-family:'Quicksand',sans-serif;font-size:10px;font-weight:700;cursor:pointer;transition:all .15s;}
  .ltab.locked{opacity:.3;cursor:not-allowed;}
  .ltab.act-toy{background:var(--toy-accent);border-color:var(--toy-accent);color:#fff;}
  .ltab.act-ph {background:var(--ph-accent); border-color:var(--ph-accent); color:#fff;}
  .ltab.act-fd {background:var(--fd-accent); border-color:var(--fd-accent); color:#1a0800;}
  .ltab:not(.locked):not([class*="act"]):hover{border-color:var(--gold);color:var(--gold);}

  /* Products grid */
  .products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(98px,1fr));gap:7px;}
  .prod-btn{background:var(--panel);border:2px solid var(--border);border-radius:12px;padding:9px 5px;cursor:pointer;text-align:center;transition:all .15s;position:relative;overflow:hidden;color:var(--text);font-family:'Quicksand',sans-serif;}
  .prod-btn:hover:not(:disabled){transform:translateY(-3px);}
  .prod-btn.toy-p:hover:not(:disabled){border-color:var(--toy-accent);box-shadow:0 6px 16px rgba(255,110,180,.25);}
  .prod-btn.ph-p:hover:not(:disabled) {border-color:var(--ph-accent); box-shadow:0 6px 16px rgba(61,214,140,.25);}
  .prod-btn.fd-p:hover:not(:disabled)  {border-color:var(--fd-accent);  box-shadow:0 6px 16px rgba(255,153,0,.25);}
  .prod-btn:active:not(:disabled){transform:scale(.96);}
  .prod-btn:disabled{opacity:.4;cursor:not-allowed;}
  .prod-btn.producing{background:#111;}
  .prod-btn.toy-p.producing{border-color:var(--toy-accent);}
  .prod-btn.ph-p.producing {border-color:var(--ph-accent);}
  .prod-btn.fd-p.producing  {border-color:var(--fd-accent);}
  .prod-btn.ho-toy{border-color:var(--toy-accent)!important;box-shadow:0 0 10px rgba(255,110,180,.3);}
  .prod-btn.ho-ph {border-color:var(--ph-accent)!important; box-shadow:0 0 10px rgba(61,214,140,.3);}
  .prod-btn.ho-fd  {border-color:var(--fd-accent)!important;  box-shadow:0 0 10px rgba(255,153,0,.3);}
  .prod-dot{position:absolute;top:5px;right:5px;width:7px;height:7px;border-radius:50%;display:none;animation:blink 1s infinite;}
  .toy-p .prod-dot{background:var(--toy-accent);}
  .ph-p  .prod-dot{background:var(--ph-accent);}
  .fd-p   .prod-dot{background:var(--fd-accent);}
  .prod-btn.ho-toy .prod-dot,.prod-btn.ho-ph .prod-dot,.prod-btn.ho-fd .prod-dot{display:block;}
  .prod-emoji{font-size:27px;display:block;margin-bottom:4px;}
  .prod-name{font-size:9px;font-weight:700;display:block;margin-bottom:2px;line-height:1.2;}
  .prod-price{font-size:10px;color:var(--gold);font-weight:700;display:block;margin-bottom:1px;}
  .prod-time{font-size:9px;color:var(--muted);display:block;}
  .prod-prog{position:absolute;bottom:0;left:0;right:0;height:4px;background:var(--border);}
  .prod-bar{height:100%;width:0%;}
  .toy-p .prod-bar{background:linear-gradient(90deg,var(--toy-accent),#ffaadd);}
  .ph-p  .prod-bar{background:linear-gradient(90deg,var(--ph-accent),#aaffcc);}
  .fd-p   .prod-bar{background:linear-gradient(90deg,var(--fd-accent),#ffdd88);}

  /* Sidebar right */
  .store-side{width:210px;flex-shrink:0;display:flex;flex-direction:column;gap:9px;}
  .side-panel{background:var(--surface);border:2px solid var(--border);border-radius:13px;padding:12px;}
  .side-title{font-family:'Lilita One',cursive;font-size:.82rem;color:var(--text);margin-bottom:7px;display:flex;align-items:center;gap:5px;}
  .stat-row{display:flex;justify-content:space-between;align-items:center;padding:4px 0;border-bottom:1px solid var(--border);font-size:11px;}
  .stat-row:last-child{border:none;}
  .stat-row .sv{font-weight:700;color:var(--gold);}
  .log{font-size:10px;max-height:110px;overflow-y:auto;display:flex;flex-direction:column;gap:3px;}
  .log-e{padding:3px 6px;border-radius:5px;background:var(--panel);animation:fadeIn .3s;}
  .log-e.earn{color:var(--gold);}
  .log-e.fail{color:#ff6666;}

  /* Floaters */
  .float-money{position:fixed;font-family:'Lilita One',cursive;font-size:1rem;color:var(--gold);pointer-events:none;z-index:999;text-shadow:0 2px 8px rgba(0,0,0,.9);animation:floatUp 1.3s ease forwards;}
  @keyframes floatUp{0%{opacity:1;transform:translateY(0) scale(1)}100%{opacity:0;transform:translateY(-70px) scale(1.2)}}

  /* Level up */
  .lu-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:300;align-items:center;justify-content:center;backdrop-filter:blur(6px);}
  .lu-overlay.show{display:flex;}
  .lu-box{padding:26px 44px;border-radius:20px;text-align:center;font-family:'Lilita One',cursive;animation:popCard .5s cubic-bezier(.175,.885,.32,1.275);max-width:92vw;}
  .lu-box.toy-up{background:linear-gradient(135deg,#ff3d9a,#ff9de2);color:#1a0a14;box-shadow:0 0 60px rgba(255,60,150,.8);}
  .lu-box.ph-up {background:linear-gradient(135deg,#2aab6f,#7dffc2);color:#0a1a10;box-shadow:0 0 60px rgba(42,171,111,.8);}
  .lu-box.fd-up  {background:linear-gradient(135deg,#ff6600,#ffcc00);color:#1a0800;box-shadow:0 0 60px rgba(255,120,0,.8);}
  .lu-box h2{font-size:2rem;margin-bottom:5px;}
  .lu-box p{font-size:.88rem;margin-bottom:14px;}
  .lu-box button{padding:9px 22px;border-radius:10px;border:none;font-family:'Lilita One',cursive;font-size:.95rem;cursor:pointer;background:rgba(0,0,0,.2);color:#fff;}

  @keyframes popCard{0%{transform:scale(.4);opacity:0}100%{transform:scale(1);opacity:1}}
  @keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
  @keyframes fadeIn{from{opacity:0}to{opacity:1}}

  @media(max-width:820px){
    .sidebar-nav{width:60px;}
    .nav-btn span:not(.nav-icon){display:none;}
    .sidebar-logo span,.money-box .lbl,.sb-sec,.emp-panel,.sb-stats{display:none;}
    .money-box .amt{font-size:.9rem;}
    .main-area{margin-left:60px;}
    .store-view.active{flex-direction:column;}
    .store-side{width:100%;flex-direction:row;flex-wrap:wrap;}
    .side-panel{flex:1;min-width:130px;}
    .xp-wrap{display:none;}
  }
</style>
</head>
<body>

<!-- ── SIDEBAR ── -->
<nav class="sidebar-nav">
  <div class="sidebar-logo">🏪 Império<span>de Lojas</span></div>
  <div class="money-box">
    <div class="lbl">💰 Caixa Geral</div>
    <div class="amt">R$ <span id="moneyDisplay">0,00</span></div>
  </div>

  <div class="sb-sec">Lojas</div>
  <button class="nav-btn active-toy" id="nav-toy" onclick="switchStore('toy')">
    <span class="nav-icon">🧸</span> Brinquedos
    <span class="nav-badge" id="badge-toy" style="color:var(--toy-accent)">Nív.1</span>
  </button>
  <button class="nav-btn" id="nav-ph" onclick="switchStore('ph')">
    <span class="nav-icon">💊</span> Farmácia
    <span class="nav-badge" id="badge-ph" style="color:var(--ph-accent)">Nív.1</span>
  </button>
  <button class="nav-btn" id="nav-fd" onclick="switchStore('fd')">
    <span class="nav-icon">🍳</span> Restaurante
    <span class="nav-badge" id="badge-fd" style="color:var(--fd-accent)">Nív.1</span>
  </button>

  <div class="sb-sec">Funcionários</div>
  <div class="emp-panel">
    <div class="emp-title">👥 Equipe</div>
    <div id="empList"></div>
    <button class="hire-btn" id="hireBtn" onclick="hireEmployee()">+ Contratar (R$<span id="hireCost">150</span>)</button>
  </div>

  <div class="sb-sec">Resumo</div>
  <div class="sb-stats">
    <div class="sstat"><span>Total Ganho</span><span class="sv" id="sTotal">R$0</span></div>
    <div class="sstat"><span>Produzidos</span><span class="sv" id="sCooked">0</span></div>
    <div class="sstat"><span>Entregues</span><span class="sv" id="sServed">0</span></div>
  </div>
</nav>

<!-- ── MAIN ── -->
<div class="main-area">

  <!-- Header -->
  <div class="store-header toy-hdr" id="storeHeader">
    <div class="store-name" id="storeName">🧸 Brinquedos</div>
    <div class="store-meta">
      <div class="store-lvl" id="storeLvl">Nível 1</div>
      <div class="xp-wrap">
        <div class="xp-lbl"><span id="xpLbl">XP</span><span id="xpPct">0%</span></div>
        <div class="xp-bg"><div class="xp-fill toy-xp" id="xpFill"></div></div>
      </div>
    </div>
  </div>

  <!-- ── TOY STORE ── -->
  <div class="store-view active" id="view-toy">
    <div class="store-main">
      <div class="orders-box toy-box">
        <div class="box-title">📋 Pedidos <span id="toy-oc" style="font-size:10px;color:var(--muted);font-family:'Quicksand';font-weight:600">(0/4)</span></div>
        <div class="orders-list" id="toy-orders"><div class="no-orders">🧸 Aguardando clientes...</div></div>
      </div>
      <div class="products-box toy-box">
        <div class="box-title">🔧 Produzir Brinquedos</div>
        <div class="level-tabs" id="toy-ltabs"></div>
        <div class="products-grid" id="toy-grid"></div>
      </div>
    </div>
    <div class="store-side">
      <div class="side-panel">
        <div class="side-title">📊 Stats</div>
        <div class="stat-row"><span>Produzidos</span><span class="sv" id="toy-cooked">0</span></div>
        <div class="stat-row"><span>Entregues</span><span class="sv" id="toy-served">0</span></div>
        <div class="stat-row"><span>Perdidos</span><span class="sv" id="toy-failed">0</span></div>
        <div class="stat-row"><span>Ganho</span><span class="sv" id="toy-total">R$0</span></div>
      </div>
      <div class="side-panel">
        <div class="side-title">📜 Histórico</div>
        <div class="log" id="toy-log"></div>
      </div>
    </div>
  </div>

  <!-- ── PHARMACY ── -->
  <div class="store-view" id="view-ph">
    <div class="store-main">
      <div class="orders-box ph-box">
        <div class="box-title">📋 Pedidos <span id="ph-oc" style="font-size:10px;color:var(--muted);font-family:'Quicksand';font-weight:600">(0/4)</span></div>
        <div class="orders-list" id="ph-orders"><div class="no-orders">💊 Aguardando clientes...</div></div>
      </div>
      <div class="products-box ph-box">
        <div class="box-title">⚗️ Produzir Medicamentos</div>
        <div class="level-tabs" id="ph-ltabs"></div>
        <div class="products-grid" id="ph-grid"></div>
      </div>
    </div>
    <div class="store-side">
      <div class="side-panel">
        <div class="side-title">📊 Stats</div>
        <div class="stat-row"><span>Produzidos</span><span class="sv" id="ph-cooked">0</span></div>
        <div class="stat-row"><span>Entregues</span><span class="sv" id="ph-served">0</span></div>
        <div class="stat-row"><span>Perdidos</span><span class="sv" id="ph-failed">0</span></div>
        <div class="stat-row"><span>Ganho</span><span class="sv" id="ph-total">R$0</span></div>
      </div>
      <div class="side-panel">
        <div class="side-title">📜 Histórico</div>
        <div class="log" id="ph-log"></div>
      </div>
    </div>
  </div>

  <!-- ── RESTAURANT ── -->
  <div class="store-view" id="view-fd">
    <div class="store-main">
      <div class="orders-box fd-box">

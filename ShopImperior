// AUDIO
// ═══════════════════════════════════════
function getAC(){if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)();return audioCtx;}
function playBell(store){
  try{
    const ctx=getAC(), freqs=STORE_CFG[store].bell;
    freqs.forEach((f,i)=>setTimeout(()=>{
      const o=ctx.createOscillator(),g=ctx.createGain();
      o.connect(g);g.connect(ctx.destination);
      o.type='sine';o.frequency.setValueAtTime(f,ctx.currentTime);
      g.gain.setValueAtTime(.25,ctx.currentTime);
      g.gain.exponentialRampToValueAtTime(.001,ctx.currentTime+.85);
      o.start(ctx.currentTime);o.stop(ctx.currentTime+.85);
    },i*130));
  }catch(e){}
}
function playLvUp(){
  try{
    const ctx=getAC();
    [523,659,784,1047].forEach((f,i)=>setTimeout(()=>{
      const o=ctx.createOscillator(),g=ctx.createGain();
      o.connect(g);g.connect(ctx.destination);
      o.type='triangle';o.frequency.setValueAtTime(f,ctx.currentTime);
      g.gain.setValueAtTime(.2,ctx.currentTime);
      g.gain.exponentialRampToValueAtTime(.001,ctx.currentTime+.4);
      o.start(ctx.currentTime);o.stop(ctx.currentTime+.4);
    },i*160));
  }catch(e){}
}
function playFail(){
  try{
    const ctx=getAC(),o=ctx.createOscillator(),g=ctx.createGain();
    o.connect(g);g.connect(ctx.destination);
    o.type='sawtooth';o.frequency.setValueAtTime(200,ctx.currentTime);
    o.frequency.exponentialRampToValueAtTime(80,ctx.currentTime+.3);
    g.gain.setValueAtTime(.15,ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(.001,ctx.currentTime+.3);
    o.start(ctx.currentTime);o.stop(ctx.currentTime+.3);
  }catch(e){}
}


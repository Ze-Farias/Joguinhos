function earnMoney(store,amount){
  money+=amount;totalEarned+=amount;
  S[store].earned+=amount;S[store].xp+=amount;
  document.getElementById('moneyDisplay').textContent=money.toFixed(2).replace('.',',');
  document.getElementById(store+'-total').textContent='R$'+Math.floor(S[store].earned);
  document.getElementById('sTotal').textContent='R$'+Math.floor(totalEarned);
}
function showFloat(text){
  const el=document.createElement('div');el.className='float-money';el.textContent=text;
  el.style.left=(Math.random()*50+30)+'%';el.style.top='60px';
  document.body.appendChild(el);setTimeout(()=>el.remove(),1400);
}
function updateXpBar(){
  const store=currentStore,s=S[store],xpArr=STORE_CFG[store].xpArr;
  document.getElementById('storeLvl').textContent='Nível '+s.level;
  document.getElementById('badge-toy').textContent='Nív.'+S.toy.level;
  document.getElementById('badge-ph').textContent='Nív.'+S.ph.level;
  document.getElementById('badge-fd').textContent='Nív.'+S.fd.level;
  if(s.level>=xpArr.length-1){
    document.getElementById('xpLbl').textContent='Nível Máximo 🏆';
    document.getElementById('xpPct').textContent='';
    document.getElementById('xpFill').style.width='100%';return;
  }
  const cur=xpArr[s.level],next=xpArr[s.level+1];
  const rel=Math.max(0,s.xp-cur),pct=Math.min((rel/(next-cur))*100,100);
  document.getElementById('xpFill').style.width=pct+'%';
  document.getElementById('xpLbl').textContent=`XP: ${Math.floor(rel)}/${next-cur}`;
  document.getElementById('xpPct').textContent=Math.floor(pct)+'%';
}
function checkLvUp(store){
  const s=S[store],xpArr=STORE_CFG[store].xpArr,cfg=STORE_CFG[store];
  if(s.level>=xpArr.length-1)return;
  const newLv=xpArr.filter((x,i)=>i>0&&s.xp>=x).length;
  if(newLv>s.level){
    s.level=newLv;playLvUp();
    renderLvTabs(store);renderProducts(store);updateXpBar();
    addLog(store,`🎉 Nível ${newLv}! Novos produtos desbloqueados!`,'earn');
    const newP=cfg.products.filter(p=>p.level===newLv).map(p=>p.emoji+' '+p.name).join(', ');
    document.getElementById('luBox').className='lu-box '+cfg.luCls;
    document.getElementById('luEmoji').textContent=cfg.icon;
    document.getElementById('luTitle').textContent=cfg.name+' Nível '+newLv+'!';
    document.getElementById('luDesc').textContent=newP?'Novos: '+newP:'Você está mandando bem!';
    document.getElementById('luOverlay').classList.add('show');
  }
}
function closeLU(){document.getElementById('luOverlay').classList.remove('show');}

// ═══════════════════════════════════════
// EMPLOYEES
// ═══════════════════════════════════════
function hireEmployee(){
  if(money<hireCost||employees.length>=MAX_EMP)return;
  money-=hireCost;
  document.getElementById('moneyDisplay').textContent=money.toFixed(2).replace('.',',');
  const idx=employees.length;
  employees.push({id:idx,name:EMP_NAMES[idx%EMP_NAMES.length],emoji:EMP_EMOJIS[idx%EMP_EMOJIS.length],store:null,hired:true});
  hireCost=Math.round(hireCost*1.9);
  addLog('toy',`👷 ${employees[idx].name} contratado!`,'earn');
  renderEmployees();
}

function assignEmployee(empId,store){
  const emp=employees[empId];if(!emp)return;
  emp.store=emp.store===store?null:store;
  renderEmployees();
  if(emp.store){
    addLog(emp.store,`${emp.emoji} ${emp.name} foi para ${STORE_CFG[emp.store].name}!`,'earn');
    const s=S[emp.store],avail=STORE_CFG[emp.store].products.filter(p=>p.level<=s.level&&!s.producing[p.id]);
    const withOrd=avail.filter(p=>s.orders.some(o=>o.prod.id===p.id));
    const tgt=withOrd.length>0?withOrd[0]:avail[Math.floor(Math.random()*avail.length)];
    if(tgt)setTimeout(()=>produce(emp.store,tgt),600);
  }
}

function renderEmployees(){
  const list=document.getElementById('empList');list.innerHTML='';
  if(employees.length===0){
    const m=document.createElement('div');
    m.style.cssText='font-size:10px;color:var(--muted);text-align:center;padding:7px;font-style:italic;';
    m.textContent='Nenhum funcionário ainda';list.appendChild(m);
  }
  employees.forEach(emp=>{
    const card=document.createElement('div');card.className='emp-card';
    const where=emp.store?`Trabalhando em ${STORE_CFG[emp.store].name}`:'Ocioso';
    card.innerHTML=`<div class="emp-name">${emp.emoji} ${emp.name}</div>
      <div class="emp-status ${emp.store?'working':''}">${where}</div>
      <div class="emp-assign-btns">
        <button class="emp-assign-btn ${emp.store==='toy'?'asgn-toy':''}" onclick="assignEmployee(${emp.id},'toy')">🧸</button>
        <button class="emp-assign-btn ${emp.store==='ph'?'asgn-ph':''}"  onclick="assignEmployee(${emp.id},'ph')">💊</button>
        <button class="emp-assign-btn ${emp.store==='fd'?'asgn-fd':''}"  onclick="assignEmployee(${emp.id},'fd')">🍳</button>
      </div>`;
    list.appendChild(card);
  });
  const hBtn=document.getElementById('hireBtn');
  hBtn.disabled=money<hireCost||employees.length>=MAX_EMP;
  hBtn.innerHTML=employees.length>=MAX_EMP?'Equipe Completa ✓':`+ Contratar (R$<span id="hireCost">${hireCost}</span>)`;
}

// ═══════════════════════════════════════
// LOG
// ═══════════════════════════════════════
function addLog(store,text,type){
  const log=document.getElementById(store+'-log');
  const e=document.createElement('div');e.className='log-e '+(type||'');e.textContent=text;
  log.insertBefore(e,log.firstChild);
  if(log.children.length>30)log.removeChild(log.lastChild);
}

document.addEventListener('click',()=>{try{getAC().resume();}catch(e){}},{once:true});
init();

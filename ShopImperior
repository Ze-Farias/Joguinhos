// ═══════════════════════════════════════
// LEVEL TABS
// ═══════════════════════════════════════
function renderLvTabs(store){
  const s=S[store], cfg=STORE_CFG[store];
  const con=document.getElementById(store+'-ltabs');
  con.innerHTML='';
  for(let l=1;l<=cfg.maxLv;l++){
    const btn=document.createElement('button');
    const locked=l>s.level, active=l===s.viewLevel;
    btn.className='ltab'+(locked?' locked':'')+(active?' '+cfg.actCls:'');
    btn.textContent='Nív.'+l;
    if(!locked) btn.onclick=(()=>{const lv=l;return()=>{s.viewLevel=lv;renderLvTabs(store);renderProducts(store);}})();
    con.appendChild(btn);
  }
}

// ═══════════════════════════════════════
// PRODUCTS
// ═══════════════════════════════════════
function getPrice(store,prod){return prod.price*S[store].priceMult;}

function renderProducts(store){
  const s=S[store], cfg=STORE_CFG[store];
  const grid=document.getElementById(store+'-grid');
  const orderIds=new Set(s.orders.map(o=>o.prod.id));
  grid.innerHTML='';
  cfg.products.filter(p=>p.level===s.viewLevel).forEach(prod=>{
    const unlocked=prod.level<=s.level;
    const isProd=!!s.producing[prod.id];
    const hasOrd=orderIds.has(prod.id);
    const btn=document.createElement('button');
    btn.className='prod-btn '+cfg.cls+(isProd?' producing':'')+(hasOrd&&!isProd?' '+cfg.hoCls:'');
    btn.id='pb-'+store+'-'+prod.id;
    btn.disabled=!unlocked||isProd;
    btn.innerHTML=`<div class="prod-dot"></div>
      <span class="prod-emoji">${prod.emoji}</span>
      <span class="prod-name">${prod.name}</span>
      <span class="prod-price">R$ ${getPrice(store,prod).toFixed(0)}</span>
      <span class="prod-time">⏱ ${Math.ceil(prod.time*s.speedMult)}s</span>
      <div class="prod-prog"><div class="prod-bar" id="prb-${store}-${prod.id}"></div></div>`;
    if(unlocked&&!isProd) btn.onclick=()=>produce(store,prod);
    grid.appendChild(btn);
  });
}

function produce(store,prod){
  const s=S[store];
  if(s.producing[prod.id]) return;
  s.producing[prod.id]=true;
  renderProducts(store);
  const empBonus=employees.filter(e=>e.store===store&&e.hired).length;
  const spd=1/(1+empBonus*0.4);
  const dur=prod.time*s.speedMult*spd*1000;
  const start=Date.now();
  const iv=setInterval(()=>{
    const pct=Math.min(((Date.now()-start)/dur)*100,100);
    const bar=document.getElementById('prb-'+store+'-'+prod.id);
    if(bar) bar.style.width=pct+'%';
    if(Date.now()-start>=dur){clearInterval(iv);finishProd(store,prod);}
  },60);
}

function finishProd(store,prod){
  const s=S[store];
  delete s.producing[prod.id];
  s.cooked++;totalCooked++;
  document.getElementById(store+'-cooked').textContent=s.cooked;
  document.getElementById('sCooked').textContent=totalCooked;

  const matchIdx=s.orders.findIndex(o=>o.prod.id===prod.id);
  if(matchIdx!==-1){
    const order=s.orders[matchIdx];
    const card=document.getElementById('oc-'+store+'-'+order.id);
    if(card){card.classList.add('done-anim');setTimeout(()=>{s.orders.splice(matchIdx,1);renderOrders(store);renderProducts(store);},560);}
    else{s.orders.splice(matchIdx,1);renderOrders(store);renderProducts(store);}
    const earned=getPrice(store,prod);
    earnMoney(store,earned);
    s.served++;totalServed++;
    playBell(store);
    document.getElementById(store+'-served').textContent=s.served;
    document.getElementById('sServed').textContent=totalServed;
    addLog(store,`✅ ${prod.emoji} ${prod.name} entregue! +R$${earned.toFixed(0)}`,'earn');
    showFloat('+R$'+earned.toFixed(0));
  } else {
    const half=getPrice(store,prod)*.5;
    earnMoney(store,half);
    addLog(store,`📦 ${prod.emoji} sem pedido +R$${half.toFixed(0)}`,'earn');
    showFloat('+R$'+half.toFixed(0));
    renderProducts(store);
  }
  checkLvUp(store);

  // Employee auto-produce
  employees.filter(e=>e.store===store&&e.hired).forEach(()=>{
    const avail=STORE_CFG[store].products.filter(p=>p.level<=S[store].level&&!S[store].producing[p.id]);
    const withOrd=avail.filter(p=>S[store].orders.some(o=>o.prod.id===p.id));
    const tgt=withOrd.length>0?withOrd[0]:avail[Math.floor(Math.random()*avail.length)];
    if(tgt) setTimeout(()=>produce(store,tgt),700+Math.random()*1000);
  });
}

// ═══════════════════════════════════════
// ORDERS
// ═══════════════════════════════════════
function startOrders(store){
  const delays={toy:1500,ph:2200,fd:1000};
  function spawn(){
    const s=S[store];
    if(s.orders.length<s.maxOrders){
      const avail=STORE_CFG[store].products.filter(p=>p.level<=s.level);
      const prod=avail[Math.floor(Math.random()*avail.length)];
      const cust=CUSTOMERS[Math.floor(Math.random()*CUSTOMERS.length)];
      s.orders.push({id:s.orderId++,prod,customer:cust,timeLeft:Math.round(s.orderTime),maxTime:Math.round(s.orderTime)});
      renderOrders(store);renderProducts(store);
    }
    setTimeout(spawn,3200+Math.random()*3500);
  }
  setTimeout(spawn,delays[store]);
}

function tickOrders(store){
  const s=S[store];
  let expired=false;
  s.orders.forEach(o=>{
    o.timeLeft=Math.max(0,o.timeLeft-1);
    if(o.timeLeft===0){
      s.failed++;expired=true;
      document.getElementById(store+'-failed').textContent=s.failed;
      addLog(store,`❌ ${o.customer} foi embora! Perdeu ${o.prod.emoji}`,'fail');
      playFail();
    }
  });
  if(expired){s.orders=s.orders.filter(o=>o.timeLeft>0);renderProducts(store);}
  renderOrders(store);
}

function renderOrders(store){
  const s=S[store], cfg=STORE_CFG[store];
  const list=document.getElementById(store+'-orders');
  document.getElementById(cfg.oc).textContent=`(${s.orders.length}/${s.maxOrders})`;
  if(s.orders.length===0){list.innerHTML=`<div class="no-orders">${cfg.emoji} Nenhum pedido...</div>`;return;}
  [...list.querySelectorAll('.order-card')].forEach(card=>{
    const id=parseInt(card.id.split('-').pop());
    if(!s.orders.find(o=>o.id===id)&&!card.classList.contains('done-anim')) card.remove();
  });
  const nm=list.querySelector('.no-orders');if(nm)nm.remove();
  s.orders.forEach(o=>{
    const pct=(o.timeLeft/o.maxTime)*100;
    const col=pct>50?'#44dd88':pct>25?'#ffaa00':'#ff4444';
    const urgent=pct<35;
    let card=document.getElementById('oc-'+store+'-'+o.id);
    if(!card){
      card=document.createElement('div');
      card.id='oc-'+store+'-'+o.id;
      card.className='order-card'+(urgent?' '+cfg.urCls:'');
      card.innerHTML=`<div class="oc-cust">${o.customer}</div>
        <div class="oc-emoji">${o.prod.emoji}</div>
        <div class="oc-name">${o.prod.name}</div>
        <div class="oc-price">R$ ${getPrice(store,o.prod).toFixed(0)}</div>
        <div class="oc-time" id="oct-${store}-${o.id}">${o.timeLeft}s</div>
        <div class="oc-bar"><div class="oc-fill" id="ocf-${store}-${o.id}" style="width:${pct}%;background:${col}"></div></div>`;
      list.appendChild(card);
    } else {
      card.className='order-card'+(urgent?' '+cfg.urCls:'')+(card.classList.contains('done-anim')?' done-anim':'');
      const t=document.getElementById('oct-'+store+'-'+o.id);
      const f=document.getElementById('ocf-'+store+'-'+o.id);
      if(t)t.textContent=o.timeLeft+'s';
      if(f){f.style.width=pct+'%';f.style.backgroundColor=col;}
    }
  });
}


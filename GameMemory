<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jogo da Memória</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;900&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #1a0533;
    --surface: #2a1045;
    --card-back: #3d1a6e;
    --card-front: #ffffff;
    --accent: #ff6ef7;
    --accent2: #6ef7ff;
    --gold: #ffd700;
    --text: #f0e8ff;
    --muted: #9070c0;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Nunito', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 24px 16px 40px;
    overflow-x: hidden;
  }

  /* Sparkle bg */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 20%, rgba(111,60,200,0.3) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 80%, rgba(255,110,247,0.15) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .game-wrapper {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 600px;
  }

  /* Header */
  header {
    text-align: center;
    margin-bottom: 24px;
  }

  h1 {
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: 900;
    letter-spacing: -1px;
    background: linear-gradient(135deg, var(--accent2), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 4px;
  }

  .tagline {
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 1px;
  }

  /* Stats bar */
  .stats {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .stat {
    background: var(--surface);
    border: 1px solid rgba(255,110,247,0.2);
    border-radius: 12px;
    padding: 10px 20px;
    text-align: center;
    min-width: 90px;
  }

  .stat-val {
    font-size: 22px;
    font-weight: 900;
    color: var(--accent);
    display: block;
    line-height: 1;
  }

  .stat-label {
    font-size: 10px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 2px;
  }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 20px;
  }

  /* Card */
  .card {
    aspect-ratio: 1;
    perspective: 600px;
    cursor: pointer;
  }

  .card-inner {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 14px;
  }

  .card.flipped .card-inner,
  .card.matched .card-inner {
    transform: rotateY(180deg);
  }

  .card-face {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .card-back {
    background: var(--card-back);
    border: 2px solid rgba(255,110,247,0.3);
    font-size: 28px;
    transition: border-color 0.2s;
    box-shadow: 0 4px 20px rgba(0,0,0,0.4);
  }

  .card:hover:not(.flipped):not(.matched) .card-back {
    border-color: var(--accent);
    box-shadow: 0 0 20px rgba(255,110,247,0.3);
  }

  .card-front {
    background: #fff;
    transform: rotateY(180deg);
    font-size: clamp(26px, 6vw, 38px);
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  .card.matched .card-front {
    background: #f0fff4;
    box-shadow: 0 0 20px rgba(110,247,255,0.4);
    animation: matchPop 0.4s ease;
  }

  @keyframes matchPop {
    0% { transform: rotateY(180deg) scale(1); }
    50% { transform: rotateY(180deg) scale(1.12); }
    100% { transform: rotateY(180deg) scale(1); }
  }

  /* Btn */
  .btn {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--accent), #c040e8);
    color: white;
    font-family: 'Nunito', sans-serif;
    font-size: 16px;
    font-weight: 900;
    cursor: pointer;
    letter-spacing: 0.5px;
    transition: transform 0.15s, box-shadow 0.15s;
    box-shadow: 0 4px 20px rgba(255,110,247,0.4);
  }

  .btn:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(255,110,247,0.5); }
  .btn:active { transform: translateY(0); }

  /* Win overlay */
  .win-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(10,0,25,0.85);
    z-index: 100;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 16px;
    text-align: center;
    padding: 24px;
    backdrop-filter: blur(8px);
  }

  .win-overlay.show { display: flex; animation: fadeIn 0.4s ease; }

  .win-emoji { font-size: 72px; animation: bounce 0.6s ease infinite alternate; }

  @keyframes bounce {
    from { transform: translateY(0); }
    to { transform: translateY(-12px); }
  }

  .win-title {
    font-size: 2.5rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--gold), #ff8c00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .win-sub { color: var(--muted); font-size: 15px; }
  .win-score { font-size: 1.3rem; font-weight: 700; color: var(--accent2); }

  .win-btn {
    margin-top: 8px;
    padding: 14px 40px;
    border: none;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--gold), #ff8c00);
    color: #1a0010;
    font-family: 'Nunito', sans-serif;
    font-size: 16px;
    font-weight: 900;
    cursor: pointer;
    transition: transform 0.15s;
  }

  .win-btn:hover { transform: scale(1.05); }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Difficulty */
  .difficulty {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-bottom: 16px;
  }

  .diff-btn {
    padding: 6px 16px;
    border-radius: 20px;
    border: 1px solid rgba(255,110,247,0.3);
    background: transparent;
    color: var(--muted);
    font-family: 'Nunito', sans-serif;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s;
    letter-spacing: 0.5px;
  }

  .diff-btn:hover, .diff-btn.active {
    background: rgba(255,110,247,0.15);
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
</head>
<body>
<div class="game-wrapper">

  <header>
    <h1>🃏 Memória</h1>
    <p class="tagline">encontre todos os pares</p>
  </header>

  <div class="stats">
    <div class="stat">
      <span class="stat-val" id="moves">0</span>
      <div class="stat-label">Jogadas</div>
    </div>
    <div class="stat">
      <span class="stat-val" id="pairs">0</span>
      <div class="stat-label">Pares</div>
    </div>
    <div class="stat">
      <span class="stat-val" id="timer">0s</span>
      <div class="stat-label">Tempo</div>
    </div>
  </div>

  <div class="difficulty">
    <button class="diff-btn active" onclick="setDiff(this, 8)">Fácil (8 pares)</button>
    <button class="diff-btn" onclick="setDiff(this, 12)">Médio (12 pares)</button>
    <button class="diff-btn" onclick="setDiff(this, 18)">Difícil (18 pares)</button>
  </div>

  <div class="grid" id="grid"></div>

  <button class="btn" onclick="startGame()">↺ Novo Jogo</button>

</div>

<!-- WIN SCREEN -->
<div class="win-overlay" id="winOverlay">
  <div class="win-emoji">🏆</div>
  <div class="win-title">Você ganhou!</div>
  <div class="win-score" id="winScore"></div>
  <div class="win-sub">Continue praticando para melhorar seu tempo!</div>
  <button class="win-btn" onclick="closeWin()">Jogar Novamente 🎮</button>
</div>

<script>
  const EMOJIS = ['🐶','🐱','🐭','🐹','🐰','🦊','🐻','🐼','🐨','🐯','🦁','🐸','🐵','🐔','🐧','🦆','🦉','🐺','🦋','🐢','🐙','🦀','🐡','🌸'];

  let flipped = [];
  let matched = 0;
  let moves = 0;
  let totalPairs = 8;
  let canFlip = true;
  let timerInterval = null;
  let seconds = 0;
  let gameStarted = false;

  function setDiff(btn, pairs) {
    document.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    totalPairs = pairs;
    startGame();
  }

  function startGame() {
    clearInterval(timerInterval);
    seconds = 0;
    moves = 0;
    matched = 0;
    flipped = [];
    canFlip = true;
    gameStarted = false;
    updateStats();

    const cols = totalPairs <= 8 ? 4 : totalPairs <= 12 ? 4 : 6;
    document.getElementById('grid').style.gridTemplateColumns = `repeat(${cols}, 1fr)`;

    const pool = [...EMOJIS].slice(0, totalPairs);
    const cards = shuffle([...pool, ...pool]);

    const grid = document.getElementById('grid');
    grid.innerHTML = '';

    cards.forEach((emoji, i) => {
      const card = document.createElement('div');
      card.className = 'card';
      card.dataset.emoji = emoji;
      card.innerHTML = `
        <div class="card-inner">
          <div class="card-face card-back">✨</div>
          <div class="card-face card-front">${emoji}</div>
        </div>`;
      card.addEventListener('click', () => flipCard(card));
      // staggered entrance
      card.style.opacity = '0';
      card.style.transform = 'scale(0.8)';
      setTimeout(() => {
        card.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
        card.style.opacity = '1';
        card.style.transform = 'scale(1)';
      }, i * 35);
      grid.appendChild(card);
    });
  }

  function flipCard(card) {
    if (!canFlip || card.classList.contains('flipped') || card.classList.contains('matched')) return;

    if (!gameStarted) {
      gameStarted = true;
      timerInterval = setInterval(() => {
        seconds++;
        document.getElementById('timer').textContent = seconds + 's';
      }, 1000);
    }

    card.classList.add('flipped');
    flipped.push(card);

    if (flipped.length === 2) {
      moves++;
      document.getElementById('moves').textContent = moves;
      canFlip = false;

      const [a, b] = flipped;
      if (a.dataset.emoji === b.dataset.emoji) {
        // Match!
        setTimeout(() => {
          a.classList.add('matched');
          b.classList.add('matched');
          matched++;
          document.getElementById('pairs').textContent = matched;
          flipped = [];
          canFlip = true;
          if (matched === totalPairs) showWin();
        }, 400);
      } else {
        // No match
        setTimeout(() => {
          a.classList.remove('flipped');
          b.classList.remove('flipped');
          flipped = [];
          canFlip = true;
        }, 900);
      }
    }
  }

  function showWin() {
    clearInterval(timerInterval);
    const score = Math.max(1000 - moves * 10 - seconds * 2, 100);
    document.getElementById('winScore').textContent = `${moves} jogadas · ${seconds}s · ${score} pts`;
    document.getElementById('winOverlay').classList.add('show');
  }

  function closeWin() {
    document.getElementById('winOverlay').classList.remove('show');
    startGame();
  }

  function updateStats() {
    document.getElementById('moves').textContent = moves;
    document.getElementById('pairs').textContent = matched;
    document.getElementById('timer').textContent = seconds + 's';
  }

  function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  startGame();
</script>
</body>
</html>
